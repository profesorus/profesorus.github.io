.translation-notice {
  background: #fff8e1;
  padding: 1rem;
  border-left: 4px solid #ffc107;
  margin: 1rem 0;
}
</style>
<style>
.notice {
  padding: 1rem;
  margin: 1rem 0;
  border-radius: 4px;
}
.translation-notice {
  background: #e3f2fd;
  border-left: 4px solid #2196f3;
}
</style>
