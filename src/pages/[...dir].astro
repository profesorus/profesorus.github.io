<!-- <Layout title={pageData.title} language={lang}> -->
<Layout language={currentLang}>

  <!-- 🔘 DIR 🌀 [...DIR].astro -->
  {/*
  <hr>
  <nav aria-label="Nawigacja językowa">
    <span style="margin:0 10px 0 0;">🔘</span>
    <a href={grl(currentLang, '/')}>
      <!-- {currentLang === 'pl' ? 'Home' : 'Startseite'} -->
    </a>
    <a href={grl('pl', isHome ? '/' : `+/${contentToShow?.slug || ''}`)}>
      PL
    </a> |
    <a href={grl('de', isHome ? '/' : `+/${contentToShow?.slug || ''}`)}>
      DE
    </a>
  </nav>
  <hr>
  */}

  <main>
    {isHome ? (
      <h1>{currentLang === 'pl' ? '🇵🇱 Witamy !!!' : '🇩🇪 Willkommen !!!'}</h1>
      <>
      <home.Content />
      </>
    ) : exists ? (
      <>
        {isAlternate && (
          <div class="notice translation-notice">
            {currentLang === 'pl'
              ? 'Pokazujemy wersję niemiecką (strona polska nie istnieje)'
              : 'Wir zeigen die polnische Version (deutsche Seite existiert nicht)'}
          </div>
        )}
        {contentToShow && (
          <>
            {/*<h1>{contentToShow.data.title}</h1>*/}
            <contentToShow.Content />
          </>
        )}
      </>
    ) : (
      <h1>404 - {currentLang === 'pl' ? 'Strona nie istnieje' : 'Seite nicht gefunden'}</h1>
    )}
  </main>

  <!--
  <footer>
    <p>{new Date().getFullYear()} ©
    {currentLang === 'pl' ? 'Wszelkie prawa zastrzeżone' : 'Alle Rechte vorbehalten'}</p>
  </footer>
  -->

