---
// src/pages/[...dir].astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl as grl } from 'astro:i18n';
// import { getRelativeLocaleUrl } from 'astro:i18n';

export async function getStaticPaths() {
  const [plPages, dePages] = await Promise.all([
    getCollection('pl'),
    getCollection('de')
  ]);

  const paths = [];
  const contentMap = new Map();

  // Przygotuj mapę zawartości
  const prepareContent = async (page, lang) => {
    if (!page) return null;
    const { Content } = await page.render();
    return {
      Content,
      data: page.data,
      slug: page.slug.replace(/^\/|\/$/g, '')
    };
  };

  // Stwórz pary tłumaczeń
  for (const plPage of plPages) {
    const dePage = dePages.find(p => p.id === plPage.id);
    contentMap.set(plPage.slug, {
      pl: await prepareContent(plPage, 'pl'),
      de: await prepareContent(dePage, 'de')
    });
  }

  // Dodaj strony DE bez tłumaczeń PL
  for (const dePage of dePages) {
    if (!contentMap.has(dePage.slug)) {
      contentMap.set(dePage.slug, {
        pl: null,
        de: await prepareContent(dePage, 'de')
      });
    }
  }

  // Generuj ścieżki
  for (const [slug, content] of contentMap) {
    const cleanSlug = slug.replace(/^\/|\/$/g, '');

    ['pl', 'de'].forEach(lang => {
      const targetContent = content[lang] || content[lang === 'pl' ? 'de' : 'pl'];

      if (targetContent) {
        paths.push({
          params: {
            dir: lang === 'pl' ? `+/${cleanSlug}` : `de/+/${cleanSlug}`
          },
          props: {
            requestedLang: lang,
            contentToShow: targetContent,
            isAlternate: !content[lang],
            exists: true
          }
        });
      }
    });
  }

  // Strony główne
  paths.push(
    {
      params: { dir: undefined },
      props: { isHome: true, requestedLang: 'pl', exists: true }
    },
    {
      params: { dir: 'de' },
      props: { isHome: true, requestedLang: 'de', exists: true }
    }
  );

  return paths;
}

const { requestedLang, contentToShow, isAlternate, isHome, exists } = Astro.props;
const currentLang = contentToShow?.lang || requestedLang;

// console.log(Astro.props);

//: --------------------------------------------------------
//: Home Page

const home = requestedLang === 'de'
  ? await import('../content/home/home.de.md')
  : await import('../content/home/home.pl.md');

const { title, description } = home.frontmatter;

//: --------------------------------------------------------
---
{/* ------------------------------------------------------------------------ */}
<style>
