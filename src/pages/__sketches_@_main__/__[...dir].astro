import Layout from '../layouts/Layout.astro';

//: ============================================================================
//: REQUIRED: getStaticPaths() function is required for dynamic routes
//: ============================================================================
//: via GLOB |||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
//: ============================================================================
export async function getStaticPaths() {
  //: ------------------------------------------------------
  const postEntries = import.meta.glob('./___test___/*.md', { eager: true });

  const languages = ['', 'de'];

  // console.log("========", postEntries);
  //: ------------------------------------------------------
  return Object.entries(postEntries).flatMap(([filePath, entry]) => {

    // TypeScript użytkowników może chcieć dodać typowanie dla 'entry'
    const slug = entry.frontmatter?.slug ||
      filePath.split('/').pop()?.replace('.md', '') || '';

    return languages.map(lang => ({
      //:
      params: { dir: `${lang}/${slug}` },
      //:
      props: {
        post: {
          file: filePath,
          frontmatter: entry.frontmatter || {},
          Content: entry.default // Komponent Content
        },
        language: lang || 'pl', // Domyślny język
        // language: lang,
        originalSlug: slug
      }
    }));
  });
}

// Alternatywne podejście (dla bardzo złożonych przypadków):
