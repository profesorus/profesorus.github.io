---
//: ==================================================================
import Layout from '../../../layouts/Layout.astro';
//: ==================================================================
import { getCollection } from 'astro:content';
//: ==================================================================
//: REQUIRED getStaticPaths() @ DYNAMIC PATHS
//: -----------------------------------------
export function getStaticPaths() {
  return [
    { params: { lang: "de" }},
    { params: { lang: "pl" }},
  ];
}
//: ==================================================================
const title = "---";
const description = "";
const keywords = "";
const { lang } = Astro.params;
//: =========================================
// const dePosts = await getCollection('de');
// const dePosts = await getCollection('+');
const xPosts = await getCollection(lang);
//: ==================================================================
---
<Layout title={title} description={description} keywords={keywords} lang={lang}>

  <style>
  h2 { margin-bottom: 5px; }
  li::marker { color: darkgray; }
  li { color: darkgray; }
  li { list-style-type: decimal-leading-zero; }
  small { vertical-align:top; font-size:50%; }
  </style>

  <h1>[lang]/+/[slug] @ sauerland.pl</h1>
  <h2>params: {lang}</h2>
  <ol>
    {xPosts.map(post => {
      const name = post.data.title || post.id;
      // return <li><a href={`/de/-/${post.slug}`}>{name}</a></li>;
      return <li>[{post.slug}] <a href={`/${lang}/+/${post.slug}`}>{name}</a></li>;
    })}
  </ol>

</Layout>
