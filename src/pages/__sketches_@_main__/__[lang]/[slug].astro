---
//: ==================================================================
import Layout from '../../layouts/Layout.astro';
//: ==================================================================
//: REQUIRED: getStaticPaths() function is required for dynamic routes
//: ==================================================================
export async function getStaticPaths() {

  const postModules = import.meta.glob('../../content/**/*.md');

  return await Promise.all(
    Object.entries(postModules).map(async ([filePath, module]) => {
      const post = await module();

      //: /txt/uber.mich/
      const _url = filePath
            //: -----------------------------
            //: .replace('../content', '')
            .replace('../../content', '')
            //: -----------------------------
            .replace('.md', '')
            .replace('/index', '/'); // opcjonalnie dla plików index.md

      //: [ '', 'txt', 'uber', '' ] -> [ 'txt', 'uber' ]
      const parts = _url.split('/').filter(Boolean); //: no empty
      const _lang = parts[0];
      const _slug = parts[1];

      //const _lang = (parts[0] === 'txt') ? 'pl' : parts[0];

      return {
        params: {
          lang: _lang || '--',
          slug: post.frontmatter.slug || _slug,
        },
        props: {
          post
        },
      };
    })
  );
}
///////////////////////////////////
// let xx = await getStaticPaths();
// console.log(xx)
///////////////////////////////////
//: ==================================================================
const { lang } = Astro.params; //: + params
//: -----------------------------------------
const { post } = Astro.props;
const { Content } = post;
//: -------------------------------
//: { lang: 'de', slug: '01' }
//: { lang: 'txt', slug: '000-ja-inni-oraz-pomiedzy' }
//: -------------------------------
// console.log(Astro.params); //:
//: ==================================================================
const title = post.frontmatter.title || post.file.split('/').pop().replace('.md', '');
const description = "Opis strony"; // Placeholder, can be dynamic later
const keywords = "słowa kluczowe"; // Placeholder, can be dynamic later
//: ==================================================================
---
<Layout title={title} description={description} keywords={keywords} lang={lang}>

  [ LANG ] 👄 [SLUG].astro

  <Content />
</Layout>
