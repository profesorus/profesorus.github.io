---
//: ==================================================================
import Layout from '../../../layouts/Layout.astro';
//: ==================================================================
import { getRelativeLocaleUrl as grl } from 'astro:i18n';
import { getRelativeLocaleUrlList as grll } from 'astro:i18n';
//: ==================================================================
import { getCollection } from 'astro:content';
//: ==================================================================
//: REQUIRED getStaticPaths() @ DYNAMIC PATHS
//: -----------------------------------------
export function getStaticPaths() {
  return [
    { params: { lang: "de" }},
    { params: { lang: "pl" }},
  ];
}
//: ==================================================================
// const dePosts = await getCollection('de');
const txtPosts = await getCollection('txt');
//: ==================================================================
const title = "---";
const description = "";
const keywords = "";
// const lang = "de";
const { lang } = Astro.params;
//: ==================================================================
---
<Layout title={title} description={description} keywords={keywords} lang={lang}>

  <h1>/lang/-/--- @ sauerland.pl</h1>
  <h2>Deutsch</h2>
  <ul>
    {txtPosts.map(post => {
      const name = post.data.title || post.id;
      return <li><a href={`/de/txt/${post.slug}`}>{name}</a></li>;
    })}
  </ul>

</Layout>
