---
//: ==================================================================
import Layout from '../../layouts/Layout.astro';
//: ==================================================================
import { getRelativeLocaleUrl as grl } from 'astro:i18n';
import { getCollection } from 'astro:content';
//: ==================================================================
//: REQUIRED getStaticPaths() @ DYNAMIC PATHS
//: -----------------------------------------
export function getStaticPaths() {
  return [
    { params: { lang: "pl" }},
    { params: { lang: "de" }},
    { params: { lang: "txt" }}, //: <<<<<<<<<
    { params: { lang: "uni" }}, //: <<<<<<<<<
  ];
}
//: ==================================================================
/*
{
  id: '00.md',
  data: { title: 'Prof. dr hab. Karol Sauerland', lang: 'pl' },
  filePath: 'src/content/pl/00.md',
  digest: 'd7556a9ec2dd59bc',
  collection: 'pl',
  slug: '00',
  render: [Function: render]
}
*/
//: ==================================================================
const title = "---";
const description = "";
const keywords = "";
// const lang = "de";
// const { lang } = Astro.params;
let { lang } = Astro.params;
// if (lang === '+') lang = 'pl'
//: ==================================================================
//: const dePosts = await getCollection('de');
const xPosts = await getCollection(lang);
// const xPosts = await getCollection('pl');
//: ==================================================================
---
<Layout title={title} description={description} keywords={keywords} lang={lang}>

  <h1>[lang]: {'{'} {lang} {'}'} @ sauerland.pl</h1>
  <h2>------</h2>
  <ul>
    {xPosts.map(post => {
      const name = post.data.title || post.id;
      // return <li><a href={`/${post.collection}/+/${post.slug}`}>{name}</a></li>;
      return <li><a href={`${grl(lang, post.slug)}`}>{name}</a></li>;
    })}
  </ul>

</Layout>
