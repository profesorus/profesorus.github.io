const { slug } = Astro.params;
const { post } = Astro.props;
const { Content } = post;
///////////////////////////////////
//: console.log(post); //: Module
//: console.log(Astro.params);
//: ==================================================================
const title = post.frontmatter.title || post.file.split('/').pop().replace('.md', '');
const description = "Opis strony"; // Placeholder, can be dynamic later
const keywords = "słowa kluczowe"; // Placeholder, can be dynamic later
const lang = Astro.params.lang; // Get lang from params
// const lang = "de"; // Get lang from params
//: ==================================================================
---
<Layout title={title} description={description} keywords={keywords} lang={lang}>

  LANG (txt) 👄👄👄 [SLUG].astro 👄 {slug} // {lang}

  <Content />
</Layout>
