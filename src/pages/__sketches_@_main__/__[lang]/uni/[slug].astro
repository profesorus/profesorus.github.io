    //   url: _url || filePath
    //     .replace('../content', '')
    //     .replace('.md', '')
    //     // .replace(`/${_lang}/`, `/${_lang}/+/`)
    //     // .replace(`/${_lang}/`, `${grl(_lang, '+')}`)
    //     .replace(_ls, _lr)
    //     .replace('/index', '/') // opcjonalnie dla index.md
    // };

      console.log({_lang, _slug});
      // console.log({_slug});


      //: /txt/uber.mich/
      const _url = filePath
            //: -----------------------------
            //: .replace('../content', '')
            //: .replace('../../content', '')
            .replace('../../../content', '')
            //: -----------------------------
            .replace('.md', '')
            //: -----------------------------
            // .replace(`/${_lang}/`, `${grl(_lang, 'txt')}`)
            //: -----------------------------
            .replace('/index', '/'); // opcjonalnie dla plików index.md

      console.log({_url});

      //: [ '', 'txt', 'uber.mich', '' ] -> [ 'txt', 'uber.mich' ]
      const parts = _url.split('/').filter(Boolean); //: no empty
      // const _lang = parts[0];
      // const _slug = parts[1];


      return {
        params: {
          lang: _lang,
          slug: post.frontmatter.slug || _slug,
        },
        props: {
          post
        },
      };
    })
  );
}
