export async function getStaticPaths() {

  // const postModules = import.meta.glob('../../../content/**/*.md');
  // const postModules = import.meta.glob('../../../content/txt/*.md');
  const postModules = import.meta.glob('../../../content/uni/*.md');

  return await Promise.all(
    Object.entries(postModules).map(async ([filePath, module]) => {
      const post = await module();

    //: use slug @ url @see [slug].astro
    const _lang = 'de';
    // const _lang = post.frontmatter.lang;
    const _slug = post.frontmatter.slug;

    // const _url = _slug ? `/${_lang}/+/${_slug}` : false;
