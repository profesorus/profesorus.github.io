---
import Layout from '../../layouts/Layout.astro';
//: ==================================================================
import { getCollection } from 'astro:content';
/*
{
  id: '00.md',
  data: { title: 'Prof. dr hab. Karol Sauerland', lang: 'pl' },
  filePath: 'src/content/pl/00.md',
  digest: 'd7556a9ec2dd59bc',
  collection: 'pl',
  slug: '00',
}
*/
const posts = await getCollection('uni');
// console.log(posts[0]);
//: ==================================================================
const title = "Karol Sauerland ° TXT";
const description = "";
const keywords = "";
const lang = "pl";
//: -------------------------------
// Astro.params.lang = 'pl';
//: ==================================================================
---
<Layout title={title} description={description} keywords={keywords} lang={lang}>

  <h1>_____ 🌀 UNI _____</h1>

  <h1>TXT</h1>
  <h2></h2>
  <ul>
    {posts.map(post => {
      const name = post.data.title || post.id;
      return <li><a href={`/${post.collection}/${post.slug}`}>{name}</a></li>;
    })}
  </ul>

</Layout>
