//: ==================================================================
/*
[
  {
    params: { lang: 'txt', slug: '000' },
    props: { post: [Object: null prototype] [Module] }
  },
  {
    params: { lang: 'txt', slug: '001' },
    props: { post: [Object: null prototype] [Module] }
  },
]
*/
//: ==================================================================
//: REQUIRED: getStaticPaths() function is required for dynamic routes
//: ==================================================================
export async function getStaticPaths() {

  const postModules = import.meta.glob('../../content/uni/*.md');

  return await Promise.all(
    Object.entries(postModules).map(async ([filePath, module]) => {
      const post = await module();

      //: /txt/uber.mich/
      const _url = filePath
            .replace('../../content', '')
            .replace('.md', '/')
            .replace('/index', '/'); // opcjonalnie dla plików index.md

      //: [ '', 'txt', 'uber.mich', '' ] -> [ 'txt', 'uber.mich' ]
      const parts = _url.split('/').filter(Boolean); //: no empty
      const _lang = parts[0];
      const _slug = parts[1];

      return {
        //: ___pf_: {...post.frontmatter},
        //: params: { lang, slug },
        params: {
          //...post.frontmatter,
          // lang,
          // slug,
          // fil_: post.file,
          // fip_: filePath,
          // url_: _url,
          lang: post.frontmatter.lang || 'pl',
          slug: post.frontmatter.slug || _slug,
        },
        props: {
          post
        },
      };
    })
  );
}
