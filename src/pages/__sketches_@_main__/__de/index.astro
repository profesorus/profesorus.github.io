---
//: ==================================================================
import Layout from '../../layouts/Layout.astro';
//: ==================================================================
import { getCollection } from 'astro:content';
/*
{
  id: '00.md',
  data: { title: 'Prof. dr hab. Karol Sauerland', lang: 'pl' },
  filePath: 'src/content/pl/00.md',
  digest: 'd7556a9ec2dd59bc',
  collection: 'pl',
  slug: '00',
  render: [Function: render]
}
*/
const dePosts = await getCollection('de');
// const dePosts = await getCollection('+');
//: ==================================================================
const title = "---";
const description = "";
const keywords = "";
const lang = "de";
//: ==================================================================
---
<Layout title={title} description={description} keywords={keywords} lang={lang}>

  <h1>DE @ sauerland.pl</h1>
  <h2>Deutsch</h2>
  <ul>
    {dePosts.map(post => {
      const filename = post.data.title || post.id;
      return <li><a href={`/${post.collection}/${post.slug}`}>{filename}</a></li>;
    })}
  </ul>

</Layout>
