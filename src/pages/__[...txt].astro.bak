---
// src/pages/[...txt].astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl as grl } from 'astro:i18n';
// import { getRelativeLocaleUrl } from 'astro:i18n';

//: --------------------------------------------------------
export async function getStaticPaths() {
  const txtPages = await getCollection('txt');

  const pagePaths = await Promise.all(
    txtPages.map(async (page) => {
      const slug = page.slug.replace(/^\/|\/$/g, '');
      const { Content } = await page.render();

      return [
        // Wersja polska (/txt/...)
        {
          params: { txt: `txt${slug ? `/${slug}` : ''}` },
          props: {
            pageData: page.data,
            Content,
            lang: 'pl',
            isHome: !slug,
            currentSlug: slug
          }
        },
        // Wersja niemiecka (/de/txt/...)
        {
          params: { txt: `de/txt${slug ? `/${slug}` : ''}` },
          props: {
            pageData: page.data,
            Content,
            lang: 'de',
            isHome: !slug,
            currentSlug: slug
          }
        }
      ];
    })
  );

  // return pagePaths.flat();

  // Spłaszczamy tablicę i dodajemy strony główne
  return [
    ...pagePaths.flat(),
    // Strona główna PL (/txt/)
    {
      params: { txt: 'txt' },
      props: {
        isHome: true,
        lang: 'pl',
        currentSlug: ''
      }
    },
    // Strona główna DE (/de/txt/)
    {
      params: { txt: 'de/txt' },
      props: {
        isHome: true,
        lang: 'de',
        currentSlug: ''
      }
    }
  ];

}

const { pageData, Content, isHome, lang, currentSlug } = Astro.props;
---
<!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
<!-- <Layout title={pageData.title} language={lang}> -->
<Layout language={lang}>

  <!-- 🛍 TXT 🌀 [...TXT].astro -->

  <hr>
  <nav aria-label="Nawigacja językowa">
    <span style="margin:0 10px 0 0;">🛍</span>
    <!-- <a href={grl(lang, isHome ? '/txt/' : `/txt/${currentSlug}`)}>
      {isHome ? (lang === 'pl' ? 'Home' : 'Startseite') : pageData.title}
    </a> | -->
    <a href={grl('pl', isHome ? '/txt/' : `/txt/${currentSlug}`).replace(/\/$/g, '')}
      class={lang === 'pl' ? 'active' : ''}>PL
    </a> |
    <a href={grl('de', isHome ? '/txt/' : `/txt/${currentSlug}`).replace(/\/$/g, '')}
      class={lang === 'de' ? 'active' : ''}>DE
    </a>
  </nav>
  <hr>

  <main>
    {isHome ? (
      <h1>{lang === 'pl' ? 'Witamy w TXT' : 'Willkommen bei TXT'}</h1>
    ) : (
      <>
        {/*<h1>{pageData.title}</h1>*/}
        <Content />
      </>
    )}
  </main>

</Layout>

{/* ************************************************************************ */}
<!-- <!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    {isHome
      ? (lang === 'pl' ? 'TXT - Strona główna' : 'TXT - Startseite')
      : pageData.title}
  </title>
</head>
<body> -->
