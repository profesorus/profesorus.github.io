---
//: Layout.astro
//: ==================================================================
import Header from '../components/Header.astro';
// import Socializer from '../components/Socializer.astro';
import Navigate from '../components/Navigate.astro';
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';

import { getRelativeLocaleUrl } from 'astro:i18n';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { getPathByLocale } from 'astro:i18n';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  lang?: string;
  url?: string;
  image?: string;
}

const {
  // title = "sauerland.pl",
  title = "", //: dev
  description = "",
  keywords = "",
  lang = Astro.url.pathname.startsWith('/de') ? 'de' : 'pl',
  url = Astro.url.href.replace(/\/$/, ''),
  image = "/img/thumbnail.jpg"
} = Astro.props;

//: ==================================================================

const otherLang = lang === 'de' ? 'pl' : 'de';
const otherLangUrl = lang === 'de'
  ? url.replace('/de', '')
  : (url.replace('/pl', '') + '/de').replace('//de', '/de');
// const otherLangUrl = lang === 'de'
//   ? Astro.url.origin +''+ getRelativeLocaleUrl('pl', Astro.url.pathname)
//   : Astro.url.origin +''+ getRelativeLocaleUrl('de', Astro.url.pathname);

const print = lang === 'de'
  ? 'Prof. Dr. Karol Sauerland'
  : 'Prof. dr hab. Karol Sauerland';

// <h1>The current URL is: {Astro.url}</h1>
// <h1>The current URL pathname is: {Astro.url.pathname}</h1>
// <h1>The current URL origin is: {Astro.url.origin}</h1>
// The current URL is: http://localhost:4321/
// The current URL pathname is: /
// The current URL origin is: http://localhost:4321
//
// Example: Construct a canonical URL using your production domain
// const canonicalURL = new URL(Astro.url.pathname, Astro.site);

/*
const preloadLink = document.createElement("link");
preloadLink.href = "myscript.js";
preloadLink.rel = "preload";
preloadLink.as = "script";
document.head.appendChild(preloadLink);
*/
const imgPreload = () => {
  const images = [
    '/img/bydg.doc.png',
    '/img/SAUERLAND_6525677_255x255px.png',
    '/img/SAUERLAND_H5M2904_255x400px.png',
    '/img/SAUERLAND_H5M3011_255x300px.png',
    '/img/SAUERLAND_pwm_255x340px.png'
  ];
  return;
  return images.map(img => (
    `<link rel="preload" href="${img}" as="image" />\n`
  ))
}

//: ==================================================================
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="thumbnail" content={image} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="veriKami °// Weronika Kami" />
    <meta name="pubdate" content="2012/12/12" />
    <meta name="google-site-verification" content="TmfmJPt_PQP6v6s67gayf4OO4LmyZvbNuxjEPbSh7ZI" />
    <meta name="google-translate-customization" content="7feffbecae40038c-87e0669e4269513a-gce5ba60cd1ea942e-c" />
    <meta name="msvalidate.01" content="E24E06C91FCD65167B8C2512722479ED" />

    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="canonical" href={url}>
    <link rel="alternate" href={otherLangUrl} hreflang={otherLang} />
    <link rel="image_src" href={image} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Karol Sauerland" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="fb:admins" content="1154154847" />

    <link rel="stylesheet" type="text/css" href="/style.css" />

    <!-- Google Analytics (Universal Analytics) -->
    <script type="text/javascript">
      var _gaq = _gaq || [];
      _gaq.push(['_setAccount', 'UA-36967092-1']);
      _gaq.push(['_trackPageview']);
      (function() {
        var ga = document.createElement('script'); ga.type = 'text/javascript'; ga.async = true;
        ga.src = ('https:' == document.location.protocol ? 'https://ssl' : 'http://www') + '.google-analytics.com/ga.js';
        var s = document.getElementsByTagName('script')[0]; s.parentNode.insertBefore(ga, s);
      })();
    </script>
    <!-- Google Tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-22BW78BJNJ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-22BW78BJNJ');
    </script>

    <Fragment set:html={imgPreload()} />

  </head>
  <body>
    <button class="hamburger-button" aria-label="Open menu">
      <span class="hamburger-icon"></span>
    </button>
    <div class="layout-wrapper">
      <aside class="left-panel">
        <Header>
          <Menu />
        </Header>
      </aside>
      <main class="right-panel">
        <div id="content">
          <!-- <Socializer /> -->
          <Navigate />
          <div style="clear:both;"></div>
          <h1 class="print">{print}</h1>
          <hr class="print" />
          <div class="main">
            <slot />
          </div>
          <Footer />
        </div>
      </main>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const hamburgerButton = document.querySelector('.hamburger-button');
        const body = document.querySelector('body');
        if (hamburgerButton && body) {
          hamburgerButton.addEventListener('click', () => {
            body.classList.toggle('menu-open');
          });
        }
      });
    </script>
  </body>
</html>
