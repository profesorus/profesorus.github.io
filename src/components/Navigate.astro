---
//: Navigate.astro
//: ==================================================================
import { getRelativeLocaleUrl as grl } from 'astro:i18n';

//: --------------------------------------------------------
// const { lang, slug } = Astro.params;
const p = Astro.params;

//: ==================================================================
const currentLang = Astro.url.pathname.startsWith('/de') ? 'de' : 'pl';
const otherLang = currentLang === 'de' ? 'pl' : 'de';

const getOtherLangLink = () => {
  const currentPath = Astro.url.pathname;
  if (currentLang === 'de') {
    return currentPath.replace(/^\/de/, '');
  } else {
    return currentPath.replace(/^\//, '/de/');
  }
};

const textLinks = {
  pl: [
    { href: '/txt/ausgewahlte', text: 'teksty zebrane' },
    { href: '/txt/online', text: 'teksty w sieci' },
    { href: '/txt/uber.mich', text: 'o mnie' },
  ],
  de: [
    { href: '/de/txt/ausgewahlte', text: 'Ausgewählte Texte' },
    { href: '/de/txt/online', text: 'Onlinetexte' },
    { href: '/de/txt/uber.mich', text: 'Über mich' },
  ],
};

const contactLink = currentLang === 'de' ? '/de/kontakt' : '/kontakt';

//: DECORATION
//: --------------------------------------------------------
const textLinkLast = textLinks[currentLang].slice(-1)[0];
const textLinkSeparator = ' | ';

const currentFlag = currentLang === 'pl' ? '🇵🇱' : '🇩🇪';
//: ==================================================================
---

<div id="navigate" style="float:right;">
  <div style="margin: 10px 0 0px;">
    {textLinks[currentLang].map(link => (
      <a href={link.href} alt={link.text}>{link.text}</a>
      <>{link == textLinkLast ? '' : textLinkSeparator}</>
    ))}
  </div>
  <div style="clear:both;"></div>
  <div style="margin: 10px 0 0px;">
    <a href={contactLink} alt="Kontakt">kontakt</a> |
    <a href={getOtherLangLink()} class={`lang ${currentLang === 'de' ? '' : 'active'}`} alt="">deutsch</a> |
    <a href={getOtherLangLink()} class={`lang ${currentLang === 'pl' ? '' : 'active'}`} alt="">polski</a>
  </div>
  {/*<br><small>{JSON.stringify(p)} <small>🍋</small> {currentLang}</small>*/}
  <small style="display:block;padding:8px 0;">{currentFlag}</small>
</div>
