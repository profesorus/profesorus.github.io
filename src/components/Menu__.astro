---
//: ==================================================================
import { getRelativeLocaleUrl as grl } from 'astro:i18n';
import { getRelativeLocaleUrlList as grll } from 'astro:i18n';
//: ==================================================================
import { getCollection } from 'astro:content';
//: ==================================================================
//: Astro.glob is deprecated and will be removed in a future major version of Astro.
//: const allPosts = await Astro.glob('../content/**/*.md');
//: const dePosts = allPosts.filter(post => post.file.includes('/content/de/'));
//: const plPosts = allPosts.filter(post => post.file.includes('/content/pl/'));
//: ==================================================================
//: const postModules = import.meta.glob('../content/**/*.md');
const postModules = import.meta.glob('../content/{pl,de}/*.md');
const allPosts = await Promise.all(
  Object.entries(postModules).map(async ([filePath, module]) => {
    const post = await module();

    //: use slug @ url @see [slug].astro
    const _lang = post.frontmatter.lang;
    const _slug = post.frontmatter.slug;

    // const _url = _slug ? `/${_lang}/+/${_slug}` : false;
    const _url = _slug ? grl(_lang, `/+/${_slug}`) : false;
    // console.log({ _lang, _slug, _url });

    //: lang: source & replacement
    let _ls = `/${_lang}/`;
    let _lr = `${grl(_lang, '+')}`;

    return {
      ...post.frontmatter,
      url: _url || filePath
        .replace('../content', '')
        .replace('.md', '')
        // .replace(`/${_lang}/`, `/${_lang}/+/`)
        // .replace(`/${_lang}/`, `${grl(_lang, '+')}`)
        .replace(_ls, _lr)
        .replace('/index', '/') // opcjonalnie dla index.md
    };
  })
);
// console.log(allPosts)
//: ==================================================================
// const plPosts = allPosts.filter(post => post.url.includes('/pl/'));
// const plPosts = allPosts.filter(post => !post.url.includes('/de/'));
const plPosts = allPosts.filter(post => post.url.startsWith('/+/'));
const dePosts = allPosts.filter(post => post.url.includes('/de/'));
// const plPosts = allPosts.filter(post => post.lang === 'pl');
// const dePosts = allPosts.filter(post => post.lang === 'de');
// console.log(plPosts[0]);
//: ==================================================================
function sortArray(array1) {
  //const sortedArray = typeof array1.toSorted === 'function'
  //? array1.toSorted((a, b) => a.key.localeCompare(b.key))
  //: array1.slice().sort((a, b) => a.key.localeCompare(b.key));
  const sortedArray =
  array1.slice().sort((a, b) => a.key.localeCompare(b.key));
  return sortedArray;
}
function sortArray(array1) {
  const sortedArray = array1.slice().sort((a, b) => a.key.localeCompare(b.key));
  return sortedArray;
}

// let a = sortArray(plPosts);
// let a = sortArray(array1);
// console.log(a[0]);

// console.log(plPosts)
// console.log(dePosts)
//: -------------------------------
