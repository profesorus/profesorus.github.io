// console.log(plPosts);
// console.log(plPosts[0].url.split('/').filter(Boolean));
//: ==================================================================
const currentLang = Astro.url.pathname.startsWith('/de') ? 'de' : 'pl';
//: ==================================================================

let x = {
  a:9,
  b:6
}
x = JSON.stringify(x,null,2);

const deAboutUrl = grl('de', 'about'); // e.g. "/de/about"
const plAboutUrl = grl('pl', 'about'); // e.g. "/about"
const plHomeUrl = grl('pl', '/+/'); // e.g. "/pl/" or "/"
const pll = grll('/+/txt')
const pll2 = grll('+/txt')
const plt = grl(currentLang, '+')

let y = [
  // grl('de', 'about'), // e.g. "/de/about"
  // grl('pl', 'about'), // e.g. "/about"
  grl('pl', '/+/'), // e.g. "/pl/" or "/"
  grl('pl', '+'), // e.g. "/pl/" or "/"
  grll('/+/txt'),
  grll('+/txt'),
  grll('+/'),
  grl(currentLang, '+'),
];
y = JSON.stringify(y,null,2);

let _ls = `/${currentLang}/`;
let _lr = `${grl(currentLang, '+')}`;
let _la = `${grll('+')}`;

//: ==================================================================
// import { getCollection } from 'astro:content';

// 1. Predefiniowana lista kluczy (slugi w określonej kolejności)
const featuredKeys = [
  '00',
  '01',
  '05',
  '03',
  'images',
  'video',
  'baden.badener.disput',
  '20',
];

// 2. Pobieranie danych z różnych kolekcji
const __de = await getCollection('de');
const __pl = await getCollection('pl');
const __uni = await getCollection('uni');

const lang = 'de';

// 3. Łączenie kolekcji
const __all = (lang === 'pl') ? __pl : __de;
const allContent = [...__all, ...__uni];

// 4. Tworzenie finalnej kolekcji wg kolejności z featuredKeys
const featuredContent = featuredKeys.map(key => allContent
  .find(item => item.slug === key)).filter(Boolean);

// console.log(featuredContent.map(x => ({ _: x.data.title, s: x.slug })));

