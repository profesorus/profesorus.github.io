<hr>
<nav>
  <ul>
    {featuredContent.map(item => {
      const name = item.data.menu ?? item.data.title;
      const path = (item.collection === 'uni') ? '' : '+';
      const url = grl(lang, `${path}/${item.slug}`).replace(/\/$/, '');
      return <li><a href={url} set:html={name} /></li>;
    })}
</ul>
</nav>
<hr>

<nav>
  <ul>
    {/*currentLang === 'de' ? 'de': 'pl'*/}

    {currentLang === 'de' ? (
      dePosts.map(post => {
        const name = post.title || post.url.split('/')[2];
        return <li><a href={`${post.url}`}>{name}</a></li>;
      })
    ) : (
      plPosts.map(post => {
        const name = post.title || post.url.split('/')[2];
        return <li><a href={`${post.url}`}>{name}</a></li>;
      })
    )}
  </ul>
</nav>
