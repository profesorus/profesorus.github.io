---
//: ==================================================================
import { getRelativeLocaleUrl as grl } from 'astro:i18n';
import { version } from '../../package.json';
//: ==================================================================
const currentLang = Astro.url.pathname.startsWith('/de') ? 'de' : 'pl';
// const { lang, slug } = Astro.params;
//: --------------------------------------------------------
const currentYear = new Date().getFullYear();
const currentDate = new Date().toLocaleDateString('en-GB', {
  day: '2-digit', month: '2-digit', year: 'numeric' })
  .replace('/', '.').replace('/', '.');
//: --------------------------------------------------------
const linKarol = grl(currentLang, 'kontakt').replace(/\/$/g, '');
const linKami = 'http://verikami.com';
---
<div id="copyright">
  Copyright © 2012 // {currentYear} <a href={linKarol}>Karol Sauerland</a>.
  Some rights reserved.<br />
  Coded by ° <a href={linKami} target="_blank">veriKami</a> //
  <a href={linKami} target="_blank">Kami Weronika Amelia</a>.
  Online since: 12.12.2012.<br />
  Revision: {version} (Kalliópē) 1.2.5 (Petöfi). Updated: {currentDate}.<br />
</div>
