{
  "name": "___sauerland_astro_static",
  "version": "2.0.5",
  "description": "Revision: 2.x.x (Kalliópē) 1.2.5 (Petöfi)",
  "author": "veriKami",
  "license": "MIT",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "__prebuild": "node scripts/files-cache.js pre",
    "__build": "astro build",
    "__postbuild": "node scripts/files-cache.js post",
    "prebuild:ch": "node scripts/files-cache-hash.js pre",
    "prebuild:cd": "node scripts/files-cache-date.js pre",
    "build:s": "node scripts/safe-build.js",
    "build:s1": "node scripts/safe-build-1.js",
    "build:s2": "node scripts/safe-build-2.js",
    "build:sh": "scripts/safe-build.sh",
    "pre:f": "find ./dist ! -name files ! -name dist -exec rm -rf {} +",
    "pre:s": "rsync -av --delete --exclude='.DS_Store' --exclude='*Icon*' ./public/files/ ./dist/files/",
    "prebuil_": "rm -rf ./dist/* && echo \"👄 PREBUILD\"",
    "_prebuild": "echo \"👄 PREBUILD\"",
    "_postbuild": "echo \"👄 POSTBUILD\"",
    "build": "astro build",
    "dev": "astro dev --force",
    "prev": "astro preview --open",
    "w:p": "wrangler pages deploy",
    "w:w": "wrangler deploy -c wrangler.w.jsonc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "gce:c": "git commit --allow-empty -m \"👄 Trigger workflow\"",
    "gce": "pnpm gce:c && git push origin master",
    "check": "npx npm-check-updates",
    "check:g": "npx ncu --format group"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.3",
    "@astrojs/sitemap": "^3.4.2",
    "@zade/vite-plugin-strip-html-comments": "npm:@jsr/zade__vite-plugin-strip-html-comments@^1.1.3",
    "astro": "^5.12.9",
    "fs-extra": "^11.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-deflist": "^1.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.29.0"
  }
}
